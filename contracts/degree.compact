pragma language_version >= 0.22;

import CompactStandardLibrary;

export ledger issued_credentials: Map<Bytes<32>, Boolean>;
export ledger admin: Bytes<32>;

constructor(admin_pk: Bytes<32>) {
  admin = disclose(admin_pk);
}

witness localSecretKey(): Bytes<32>;
witness degreeSubject(): Bytes<32>;
witness credentialSalt(): Bytes<32>;

export circuit issueCredential(commitment: Bytes<32>): [] {
  assert(disclose(publicKey(localSecretKey())) == admin, "Only admin can issue academic credentials");
  issued_credentials.insert(disclose(commitment), true);
}

export circuit verifyDegree(required_subject: Bytes<32>): Boolean {
  const commitment = credentialCommitment(degreeSubject(), credentialSalt());
  assert(issued_credentials.member(disclose(commitment)), "Credential was not issued by the registrar");
  assert(degreeSubject() == required_subject, "User's degree subject does not match requirement");
  
  return disclose(true);
}

export circuit credentialCommitment(subject: Bytes<32>, salt: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "degree:credential:"),
    subject,
    salt
  ]);
}

export circuit publicKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "degree:pk:"), sk]);
}
